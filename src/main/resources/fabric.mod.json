{
	"schemaVersion": 1,
	"id": "hold-to-walk",
	"version": "${version}",
	"name": "Hold to Walk",
	"description": "A mod that changes it so you sprint by default, and pressing the sprint key makes you walk.",
	"authors": [
		"Nickotato"
	],
	"contact": {
		"homepage": "https://discord.gg/aEGxqg8VbZ",
		"sources": "https://github.com/Nickotato/HoldToWalk"
	},
	"license": "CC0-1.0",
	"icon": "assets/hold-to-walk/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"me.nickotato.holdtowalk.client.HoldToWalkClient"
		],
		"modmenu": ["me.nickotato.holdtowalk.client.screen.ModMenuIntegration"]
	},
	"mixins": [
		{
			"config": "hold-to-walk.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "17.0.0"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/aEGxqg8VbZ",
				"modmenu.youtube": "https://www.youtube.com/@Nickotato"
			}
		}
	}
}